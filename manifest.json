{
  "manifest_version": 3,
  "name": "Wilmer",
  "version": "1.1",
  "description": "Marke texts in web pages and sync devices",
  "permissions": ["storage", "scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
